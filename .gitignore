/build/
/.cache/
/.pytest_cache/
__pycache__/
*.py[cod]
*.so
*.dylib
*.dll
*.egg-info/
/.venv/
/_references/
/.artifacts/
# Current CUDA ownership is derived from source + the semantic ledger and belongs
# in CI/local artifacts, not in Git (avoids a repository-wide conflict hotspot).
/docs/cuda_ownership_current.json
# Benchmark runs are staged outside the reviewed result tree. A deliberate
# small scientific fixture can still be force-added with a hash-pinned reason.
/benchmarks/results/**/attempts/
/benchmarks/results/**/*.log
# Do not let compressed logs or stray per-run directories become publications
# through a routine "git add -A". Historical tracked receipts are unaffected.
/benchmarks/results/**/*.log.gz
/benchmarks/results/**/*.log.xz
/benchmarks/results/**/*.log.zst
/benchmarks/results/**/stdout
/benchmarks/results/**/*.stdout
/benchmarks/results/**/*.stdout.*
/benchmarks/results/**/stderr
/benchmarks/results/**/*.stderr
/benchmarks/results/**/*.stderr.*
/benchmarks/results/**/logs/
/benchmarks/results/**/retries/
/benchmarks/results/**/profiling/
/benchmarks/results/**/build/
/benchmarks/results/**/*.xml
/benchmarks/results/**/*.chk
/benchmarks/results/**/*.checkpoint
/benchmarks/results/**/*.nsys-rep
/benchmarks/results/**/*.ncu-rep
/benchmarks/results/**/*.sqlite*
# Full benchmark run bundles belong in external or ignored artifact storage.
/benchmarks/results/**/*.zip
/benchmarks/results/**/*.tar
/benchmarks/results/**/*.tar.gz
/benchmarks/results/**/*.tgz
/benchmarks/results/**/*.tar.xz
/benchmarks/results/**/*.tar.zst
/benchmarks/results/**/*.7z
/docs/_build/
