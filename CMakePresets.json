{
  "version": 5,
  "configurePresets": [
    {
      "name": "cuda-dev-fast",
      "displayName": "CUDA development (fast iteration)",
      "description": "Explicit CUDA target, portable kernels, Ninja-controlled compile parallelism, and opt-in fast compiler mode.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/cuda-dev-fast",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "GENERATIVEQC_ENABLE_CUDA": "ON",
        "GENERATIVEQC_AOT_SPLIT_COMPILE_THREADS": "2",
        "GENERATIVEQC_CUDA_SPLIT_COMPILE_THREADS": "2",
        "GENERATIVEQC_CUDA_FAST_COMPILE": "ON",
        "GENERATIVEQC_CUDA_SEPARABLE_COMPILATION": "OFF",
        "GENERATIVEQC_AOT_UNIT_MODE": "class",
        "GENERATIVEQC_AOT_PROFILE": "portable"
      }
    },
    {
      "name": "cuda-release",
      "displayName": "CUDA release (explicit target)",
      "description": "Release settings for caller-selected CUDA architectures with portable kernels.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/cuda-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "GENERATIVEQC_ENABLE_CUDA": "ON",
        "GENERATIVEQC_CUDA_FAST_COMPILE": "OFF",
        "GENERATIVEQC_CUDA_SEPARABLE_COMPILATION": "OFF",
        "GENERATIVEQC_AOT_UNIT_MODE": "stable-shards",
        "GENERATIVEQC_AOT_PROFILE": "portable",
        "GENERATIVEQC_ENABLE_AUTOMATIC_XC_CUDA_AOT": "ON",
        "GENERATIVEQC_AUTOMATIC_XC_CUDA_FUNCTIONALS": ""
      }
    },
    {
      "name": "cuda-release-sm120",
      "displayName": "CUDA release (sm_120)",
      "description": "Production sm_120 AOT manifest with release compiler settings.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/cuda-release-sm120",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "GENERATIVEQC_ENABLE_CUDA": "ON",
        "GENERATIVEQC_CUDA_COMPILE_ARCHITECTURES": "120",
        "GENERATIVEQC_CUDA_FAST_COMPILE": "OFF",
        "GENERATIVEQC_CUDA_SEPARABLE_COMPILATION": "OFF",
        "GENERATIVEQC_AOT_UNIT_MODE": "stable-shards",
        "GENERATIVEQC_AOT_PROFILE": "sm_120",
        "GENERATIVEQC_ENABLE_AUTOMATIC_XC_CUDA_AOT": "ON",
        "GENERATIVEQC_AUTOMATIC_XC_CUDA_FUNCTIONALS": ""
      }
    },
    {
      "name": "cuda-release-cli",
      "displayName": "Standalone native CUDA CLI distribution (select architecture)",
      "description": "Complete automatic Libxc CUDA catalog with caller-selected architecture and portable AOT, without Python stationary plug-ins.",
      "inherits": "cuda-release",
      "binaryDir": "${sourceDir}/build/cuda-release-cli",
      "cacheVariables": {
        "GENERATIVEQC_MONOLITHIC_CLI": "ON",
        "GENERATIVEQC_BUILD_CLI": "ON",
        "GENERATIVEQC_BUILD_TESTS": "OFF",
        "GENERATIVEQC_ENABLE_AOT_SHELLS": "ON",
        "GENERATIVEQC_ENABLE_STATIONARY_FORCE_AOT": "OFF",
        "GENERATIVEQC_ENABLE_NATIVE_STATIONARY_CUDA": "ON",
        "GENERATIVEQC_ENABLE_STATIONARY_CPU_FORCE_AOT": "ON",
        "GENERATIVEQC_ENABLE_CXX_PCH": "ON",
        "GENERATIVEQC_CUDA_FAST_COMPILE": "OFF",
        "GENERATIVEQC_COMPILER_CACHE": "ccache",
        "GENERATIVEQC_CUDA_COMPILE_JOBS": "3",
        "GENERATIVEQC_AOT_COMPILE_JOBS": "2",
        "GENERATIVEQC_ENABLE_AUTOMATIC_XC_CUDA_AOT": "ON",
        "GENERATIVEQC_AUTOMATIC_XC_CUDA_FUNCTIONALS": ""
      }
    },
    {
      "name": "cuda-release-cli-sm120",
      "displayName": "Standalone native CUDA CLI distribution (sm_120)",
      "description": "Single native C++/CUDA executable: production AOT compiled into core, no Python-only stationary plug-ins; ccache/PCH enabled.",
      "inherits": "cuda-release-cli",
      "binaryDir": "${sourceDir}/build/cuda-release-cli-sm120",
      "cacheVariables": {
        "GENERATIVEQC_CUDA_COMPILE_ARCHITECTURES": "120",
        "GENERATIVEQC_AOT_PROFILE": "sm_120"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "cuda-dev-fast",
      "configurePreset": "cuda-dev-fast"
    },
    {
      "name": "cuda-release",
      "configurePreset": "cuda-release"
    },
    {
      "name": "cuda-release-sm120",
      "configurePreset": "cuda-release-sm120"
    },
    {
      "name": "cuda-release-cli",
      "configurePreset": "cuda-release-cli"
    },
    {
      "name": "cuda-release-cli-sm120",
      "configurePreset": "cuda-release-cli-sm120"
    }
  ]
}
