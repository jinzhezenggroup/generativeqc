    "source": "\"\"\"Diagnostic replay audit; excluded from every benchmark timing population.\"\"\"\nimport hashlib\nimport inspect\nimport json\nfrom pathlib import Path\n\nimport cupy as cp\nfrom generativeqc import GridSpec\nfrom benchmarks.readme_hf_scaling import scaling_cases\nfrom benchmarks.compare_gpu4pyscf_batch import load_comparison_basis\nfrom benchmarks.readme_wb97mv import reference_engine\nfrom benchmarks.readme_omol25 import reference_energy_forces\nfrom gpu4pyscf.scf import hf\n\nbase = Path('/data/jzzeng/gqc-readme-hf-df-20261013')\ncase = scaling_cases()['water-48']\n_, basis = load_comparison_basis(base/'qualified/none/inputs/def2-svp.json',case,role='orbital',compute_forces=True)\nengine = reference_engine(case.atoms,basis,GridSpec(48,16,32),xc='PBE',full_fock=True)\nengine.conv_tol=1e-12\nengine.conv_tol_grad=1e-10\nengine.direct_scf_tol=1e-14\nengine.max_cycle=100\n\ndef digest(dm):\n    return hashlib.sha256(cp.asnumpy(dm).tobytes()).hexdigest()\n\ndef execute(seed):\n    trajectory=[]\n    def callback(env):\n        trajectory.append({'iteration':int(env['cycle'])+1,'delta_e':float(env['e_tot']-env['last_hf_e']),'orbital_gradient':float(env['norm_gorb']),'density_step':float(env['norm_ddm'])})\n    engine.callback=callback\n    energy,forces,seconds=reference_energy_forces(engine,seed,export=cp.asnumpy,synchronize=cp.cuda.Stream.null.synchronize)\n    return {'energy':energy,'max_force':float(abs(forces).max()),'trajectory':trajectory,'seconds_diagnostic_only':seconds,'converged':bool(engine.converged)}\n\ncold=execute(None)\nseed=engine.make_rdm1().copy()\nseed_hash=digest(seed)\nrows=[]\nfor _ in range(5):\n    row=execute(seed)\n    row['input_seed_sha256']=digest(seed)\n    assert row['input_seed_sha256']==seed_hash\n    rows.append(row)\n# Reevaluate one frozen density directly; a differing potential demonstrates\n# floating-point variability before either diagonalization or DIIS occurs.\nvalues=[engine.get_veff(dm=seed.copy()).copy() for _ in range(5)]\ndifferences=[float(cp.max(cp.abs(x-values[0]))) for x in values[1:]]\nresult={'schema':'generativeqc.reference-replay-audit.v1','excluded_from_benchmark':True,'method':'PBE','atoms':48,'cold':cold,'replays':rows,'potential_max_abs_differences':differences,'gpu4pyscf_hf_source_sha256':hashlib.sha256(Path(inspect.getfile(hf)).read_bytes()).hexdigest(),'fixed_seed_sha256':seed_hash,'stock_diis':True,'energy_tolerance':engine.conv_tol,'gradient_tolerance':engine.conv_tol_grad}\n(base/'reference-replay-audit.json').write_text(json.dumps(result,indent=2)+'\\n')\nprint(json.dumps(result))\n"
