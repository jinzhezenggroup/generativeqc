+    visited = []
+
+    def admit(points: int) -> int:
+        visited.append(points)
+        if points > 32:
+            raise ValueError("concurrent owners exceed budget")
+        return points
+
+    selected = plan_stationary_cuda_grid_schedule(
+        grid_points=10_000,
+        tile_points=None,
+        preferred_tile_points=preference,
+        admit=admit,
+    )
