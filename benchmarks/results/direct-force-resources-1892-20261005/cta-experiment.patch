+/** Default-off launch experiment, restricted to the existing full-range force
+ * boundary. Invalid settings and nonstandard launch shapes retain the ordinary
+ * schedule. Neither operator specialization nor generated dispatch changes. */
+dim3 experimental_full_force_block(dim3 block) {
+  if (block.x != kBoundedDirectThreads || block.y != 1U || block.z != 1U) return block;
+  const char* setting = std::getenv("GENERATIVEQC_EXPERIMENT_DIRECT_FORCE_CTA_THREADS");
+  if (setting && std::strcmp(setting, "64") == 0) block.x = 64U;
+  if (setting && std::strcmp(setting, "128") == 0) block.x = 128U;
+  return block;
+}
