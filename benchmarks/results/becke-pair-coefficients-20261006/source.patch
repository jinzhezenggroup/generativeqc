+def test_coefficient_plan_charges_concurrent_storage_and_requires_geometry() -> None:
+    plan = plan_becke_pair_coefficients(
+        operation=operation(),
+        atoms=96,
+        points=256,
+        budget_bytes=1 << 30,
+        cached_geometry=True,
