+def test_recognizer_rejects_changed_ad_with_stale_identity() -> None:
+    ratio = grid_response_program("ratio")
+    changed = replace(ratio, roots=(ratio.roots[0] + 1, ratio.roots[1]))
+    arguments = {
+        "ratio": changed,
+        "logarithm": grid_response_program("log"),
