+/** Observe the real joint path, not just its dispatch predicate. RKS can borrow
+ * K's Cartesian density directly; UKS needs only a Cartesian sum. Neither
+ * path may rebuild the standalone J input scratch selected below. */
+struct JointDensitySentinel {
+  cudaStream_t stream{};
+  void* pointer{};
+  std::size_t bytes{};
+  JointDensitySentinel(CudaDirectJkPlan& plan, const FockBuildSpec& spec) : stream(plan.stream) {
+    auto* owner = plan.generated_exchange.get();
+    if (!spec.coulomb.present || !spec.exchange.present ||
+        spec.exchange.op != FockOperator::FullRange || !owner || !owner->shared ||
+        !owner->shared->value_capability || owner->bounded_value_capability)
+      return;
+    auto& shared = *owner->shared;
+    const bool unrestricted = spec.spin == FockSpin::Unrestricted;
+    pointer = unrestricted ? shared.total_density : shared.density;
+    const auto dimension = unrestricted ? shared.batch.nbf : shared.batch.direct_nbf;
+    bytes = std::size_t(shared.batch.batch_size) * dimension * dimension * sizeof(double);
+    check(cudaMemsetAsync(pointer, 0xa5, bytes, stream));
+  }
+  void verify() const {
+    if (!pointer) return;
+    std::vector<unsigned char> actual(bytes);
+    check(cudaMemcpyAsync(actual.data(), pointer, bytes, cudaMemcpyDeviceToHost, stream));
+    check(cudaStreamSynchronize(stream));
+    require(std::all_of(actual.begin(), actual.end(), [](auto byte) { return byte == 0xa5; }),
+            "joint J/K repeated standalone J density preparation");
+  }
+};
