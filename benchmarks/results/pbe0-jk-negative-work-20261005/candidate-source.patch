+    return cudaErrorNotSupported;
+  if (!coulomb || !alpha_exchange ||
+      (unrestricted ? beta_exchange == nullptr : beta_exchange != nullptr))
+    return cudaErrorInvalidValue;
+  auto error = prepare_generated_exchange_density(p, unrestricted, alpha, beta);
+  if (error != cudaSuccess) return error;
+  auto& shared = *p.shared;
+  const double* total_density = p.direct_spin;
+  if (unrestricted) {
+    // K's layout interleaves alpha/beta matrices by system. Transform each spin
+    // once, then form J's total density in the existing Cartesian scratch. No
+    // public-AO total-density matrix or second basis transform is required.
+    const auto matrix = product(std::size_t(shared.batch.direct_nbf), shared.batch.direct_nbf);
+    for (std::size_t item = 0; item < std::size_t(shared.batch.batch_size); ++item)
+      cuda_df::launch_sum_spin_density_kernel(
+          blocks(matrix), 128, 0, shared.stream, matrix, p.direct_spin + 2 * item * matrix,
+          p.direct_spin + (2 * item + 1) * matrix, shared.density + item * matrix);
+    error = cudaGetLastError();
+    if (error != cudaSuccess) return error;
+    total_density = shared.density;
+  }
+  // The integral traversals, their screening domains and outputs stay
+  // independent. Only the common input transform is shared within this call;
+  // no pointer/epoch cache or assumption about a previous request is added.
+  error = enqueue_generated_coulomb_cartesian(shared, total_density);
+  if (error != cudaSuccess) return error;
+  error = project_generated_coulomb(shared, coulomb);
+  return error == cudaSuccess
+             ? enqueue_generated_exchange_prepared(p, unrestricted, alpha_exchange, beta_exchange,
+                                                   DirectCoulombRange::Full, 0.0)
+             : error;
+}
