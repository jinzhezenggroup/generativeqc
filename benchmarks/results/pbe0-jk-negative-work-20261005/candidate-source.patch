+cudaError_t enqueue_generated_full_range_jk(GeneratedExchangePlan& p, bool unrestricted,
+                                            const double* alpha, const double* beta,
+                                            double* coulomb, double* alpha_exchange,
+                                            double* beta_exchange) {
