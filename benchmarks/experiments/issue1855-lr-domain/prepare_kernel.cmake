if(NOT DEFINED SOURCE_ROOT OR NOT DEFINED OUTPUT)
  message(FATAL_ERROR "SOURCE_ROOT and OUTPUT must identify the frozen source and diagnostic header")
endif()
file(READ "${SOURCE_ROOT}/src/scf/cuda/direct_bounded_fallback.cu" source)
set(boundary "template <bool Unrestricted, DirectRangeOperator Range, unsigned Order = 0U>")
string(FIND "${source}" "${boundary}" offset)
if(offset LESS 0)
  message(FATAL_ERROR "The frozen bounded-kernel extraction boundary has changed")
endif()
string(SUBSTRING "${source}" 0 ${offset} kernel)
file(WRITE "${OUTPUT}" "${kernel}\n}  // namespace generativeqc::scf::cuda_execution\n")
